<%# locals: (task:) %>
<%# Under a task's title, on its page and in the side panel: who on it is out on the day it's due,
    so a due date or an assignment that lands on someone's time off shows where it's set. %>
<% offs = task.due_on && Calendar::TaskRules.movable?(task) ? Calendar::TimeOff.overlapping(task.due_on..task.due_on).where(user_id: task.owners.map(&:id)).includes(:user).to_a : [] %>
<% if offs.any? %>
  <% notice = capture do %>
    <%= offs.map { |off| "#{off.user.display_name} is out #{off.span_text}" }.to_sentence %>, when this is due.
    <%= link_to "See the day", calendar_page_path(date: task.due_on.iso8601, day: task.due_on.iso8601), data: { turbo_frame: "_top" } %>
  <% end %>
  <%= ui :alert, variant: :warning, description: notice, class: "calendar-notice", role: "note" %>
<% end %>
