<%# locals: (item:, compact: nil, avatars: nil) %>
<%# One thing on a day (Calendar::Schedule::Item): a task (opens in the side panel; an open one drags
    to another day), someone out, a date field (a launch), another plugin's (a meeting) or a piece
    of work closed (each opens its record). compact: a month cell's one line; otherwise with who's
    on it and where it sits. avatars: who's on it even on one line (the week, which has the room). A
    clash marks it: someone on it is out. An open task drags the way the Tasks board's cards do: the
    whole item is what moves (the grip shows it can), and its link is never dragged itself. %>
<% draggable = item.movable? %>
<li class="<%= class_names("calendar-item", "calendar-item--#{item.kind.dasherize}", "calendar-item--overdue": item.overdue?, "calendar-item--done": item.done?,
      "calendar-item--clash": item.clash?, "calendar-item--compact": compact) %>"<% if draggable %> draggable="true" data-drag-and-drop-target="item" data-id="<%= item.record.id %>"<% end %>>
  <% if item.time_off? %>
    <span class="calendar-item__main">
      <%= person_tag item.record.user %>
      <span class="calendar-item__title"><%= item.record.user.display_name %></span>
      <span class="calendar-item__detail"><%= item.detail %></span>
    </span>
  <% elsif item.task? %>
    <%= side_panel_link_to item.record, class: "calendar-item__main", draggable: (draggable ? "false" : nil) do %>
      <% if draggable %>
        <%= icon_tag "grip", class: "calendar-item__grip" %>
      <% else %>
        <span class="calendar-item__mark" aria-hidden="true"></span>
      <% end %>
      <span class="calendar-item__title"><%= item.title %></span>
      <% unless compact %>
        <span class="calendar-item__detail"><%= item.detail %></span>
      <% end %>
    <% end %>
  <% elsif item.plugin? %>
    <% if item.record.path %>
      <%= link_to item.record.path, class: "calendar-item__main", data: { turbo_frame: "_top" } do %>
        <span class="calendar-item__mark" aria-hidden="true"></span>
        <span class="calendar-item__detail calendar-item__label"><%= item.detail %></span>
        <span class="calendar-item__title"><%= item.title %></span>
      <% end %>
    <% else %>
      <span class="calendar-item__main">
        <span class="calendar-item__mark" aria-hidden="true"></span>
        <span class="calendar-item__detail calendar-item__label"><%= item.detail %></span>
        <span class="calendar-item__title"><%= item.title %></span>
      </span>
    <% end %>
  <% else %>
    <%= link_to calendar_record_path(item.record), class: "calendar-item__main", data: { turbo_frame: "_top" } do %>
      <span class="calendar-item__mark" aria-hidden="true"></span>
      <span class="calendar-item__detail calendar-item__label"><%= item.detail %></span>
      <span class="calendar-item__title"><%= item.title %></span>
    <% end %>
  <% end %>
  <% if item.clash? %>
    <span class="calendar-item__clash" title="<%= calendar_clash_text(item.clash) %>"><%= icon_tag "bell-alert" %><span class="visually-hidden"><%= calendar_clash_text(item.clash) %></span></span>
  <% end %>
  <% if (!compact || avatars) && item.people.any? && !item.time_off? %>
    <span class="calendar-item__people">
      <% item.people.first(3).each do |person| %>
        <%# herb:key person.id %>
        <%= person_tag person %>
      <% end %>
    </span>
  <% end %>
</li>
