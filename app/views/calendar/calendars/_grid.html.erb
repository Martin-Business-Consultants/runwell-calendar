<%# locals: (period:, schedule:, day:, panel:) %>
<%# A month (whole weeks around it) or a week, a row per week, a cell per day (Saturdays and Sundays
    left out with weekends off). A month's day shows a few things and "+N more"; a week's shows
    everything. Open tasks drag to another day to move their due date (the core's drag-and-drop,
    on the whole calendar so the tasks drawer's join in: each day is a container posting to
    DropsController). %>
<% limit = period.view == "month" ? Calendar::CalendarHelper::CALENDAR_DAY_LIMIT : nil %>
<div class="<%= class_names("calendar-grid", "calendar-grid--week": period.view == "week", "calendar-grid--weekdays": !period.weekends?) %>">
  <div class="calendar-grid__weekdays" aria-hidden="true">
    <% period.weekdays.each do |date| %>
      <%# herb:key date.wday %>
      <span class="calendar-grid__weekday"><%= l(date, format: "%a") %></span>
    <% end %>
  </div>
  <% period.weeks.each do |week| %>
    <%# herb:key week.first.iso8601 %>
    <div class="calendar-grid__week">
      <%= render partial: "calendar/calendars/cell", collection: week, as: :date, locals: { schedule: schedule, period: period, day: day, limit: limit, panel: panel } %>
    </div>
  <% end %>
</div>
