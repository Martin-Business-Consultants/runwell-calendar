<%# locals: (date:, schedule:, period:, day:, limit: nil) %>
<%# One day in the grid: its number (which opens the day beside the calendar), a marker when someone
    is out as their task or date lands, and what's on it. It's a keyboard item: j / k move through
    the days, Enter opens the one you're on. %>
<% items = schedule.on(date) %>
<% shown = limit ? items.first(limit) : items %>
<div class="<%= class_names("calendar-day", "calendar-day--outside": period.outside?(date), "calendar-day--today": date == Date.current,
      "calendar-day--selected": date == day, "calendar-day--weekend": date.saturday? || date.sunday?, "calendar-day--past": date < Date.current) %>" data-filter-target="item">
  <div class="calendar-day__head">
    <%= link_to date.day, calendar_link(day: date.iso8601), class: "calendar-day__number", aria: { label: calendar_day_title(date) },
          data: { turbo_frame: "calendar_day", turbo_action: "advance" } %>
    <% if items.any?(&:clash?) %>
      <span class="calendar-day__clash" title="Someone’s out when their <%= term(:task).downcase %> or date lands"><%= icon_tag "bell-alert" %></span>
    <% end %>
  </div>
  <% if shown.any? %>
    <ul class="calendar-day__items">
      <%= render partial: "calendar/shared/item", collection: shown, as: :item, locals: { compact: true } %>
    </ul>
  <% end %>
  <% if items.size > shown.size %>
    <%= link_to "+#{items.size - shown.size} more", calendar_link(day: date.iso8601), class: "calendar-day__more",
          data: { turbo_frame: "calendar_day", turbo_action: "advance" } %>
  <% end %>
</div>
