<%# The calendar (Calendar::CalendarsController): filters and search over a month, week or agenda,
    the day picked open beside it. The filters are one GET form of comboboxes (the core's, with a
    filter box past a handful of choices) and the search, sent as each changes, so a filtered
    calendar is a link; the search box is permanent across visits (data-turbo-permanent), so typing
    keeps focus while the page refreshes under it. Weekends and the day panel are switched in the
    bar and remembered. Picking a day loads only its panel (the calendar_day frame), or, with the
    panel closed, opens it. %>
<% content_for :index_filters do %>
  <%= form_with url: calendar_page_path, method: :get, class: "calendar-filters", data: { controller: "form", turbo_action: "replace" } do |form| %>
    <% request.query_parameters.slice("view", "date", "day").each do |name, value| %>
      <%# herb:key name %>
      <input type="hidden" name="<%= name %>" value="<%= value %>">
    <% end %>
    <%= form.select :person, calendar_person_options, { selected: params[:person].presence || "anyone" }, class: "select--sm", aria: { label: "Person" }, data: { action: "change->form#submit", combobox_filter: "always" } %>
    <%= form.select :client, calendar_client_options, { selected: params[:client].presence || "all" }, class: "select--sm", aria: { label: term(:client) }, data: { action: "change->form#submit", combobox_filter: "always" } %>
    <%= form.select :work, calendar_work_options, { selected: params[:work].presence || "all" }, class: "select--sm", aria: { label: term(:work) }, data: { action: "change->form#submit", combobox_filter: "always" } %>
    <%= form.select :show, calendar_show_options, { selected: @schedule.show }, class: "select--sm", aria: { label: "Show" }, data: { action: "change->form#submit", combobox_filter: "always" } %>
    <span class="calendar-search">
      <%= icon_tag "search", class: "calendar-search__icon" %>
      <input type="search" name="q" id="calendar_search" value="<%= params[:q] %>" class="calendar-search__input" placeholder="Search people, <%= term(:work).downcase %>, <%= term(:task, count: 2).downcase %>…"
        autocomplete="off" aria-label="Search the calendar" data-turbo-permanent data-1p-ignore="true" data-action="input->form#debouncedSubmit">
    </span>
  <% end %>
  <% if @schedule.filtered? %>
    <%= link_to "Clear", calendar_page_path(params.permit(:view, :date).to_h), class: "btn btn--ghost btn--sm" %>
  <% end %>
<% end %>
<%= render "layouts/shared/index_toolbar", new_text: "Add time off", new_path: new_calendar_time_off_path(date: @day.iso8601) %>

<div class="calendar">
  <div class="calendar-bar">
    <div class="calendar-bar__nav">
      <%= link_to calendar_link(date: @period.previous.iso8601, day: nil), class: "icon-button", title: "Previous (h)", data: { keys: "h" } do %>
        <%= icon_tag "arrow-left" %><span class="visually-hidden">Previous</span>
      <% end %>
      <%= link_to "Today", calendar_link(date: nil, day: nil), class: "btn btn--secondary btn--sm", title: "Today (t)", data: { keys: "t" } %>
      <%= link_to calendar_link(date: @period.following.iso8601, day: nil), class: "icon-button", title: "Next (l)", data: { keys: "l" } do %>
        <%= icon_tag "arrow-right" %><span class="visually-hidden">Next</span>
      <% end %>
      <h2 class="calendar-bar__title"><%= @period.title %></h2>
    </div>
    <div class="calendar-bar__actions">
      <nav class="tabs tabs--pills" aria-label="View">
        <% Calendar::Period::VIEWS.each do |view, label| %>
          <%# herb:key view %>
          <%= link_to label, calendar_link(view: (view unless view == "month")), class: "tabs__tab", aria: { current: (view == @period.view ? "page" : nil) } %>
        <% end %>
      </nav>
      <%= link_to calendar_link(weekends: (@weekends ? "off" : "on")), class: "pill calendar-toggle", aria: { pressed: @weekends },
            title: (@weekends ? "Hide Saturdays and Sundays" : "Show Saturdays and Sundays") do %>
        <span class="calendar-toggle__box" aria-hidden="true"><%= icon_tag "check" %></span>
        <span>Weekends</span>
      <% end %>
      <%= link_to calendar_link(panel: (@panel ? "off" : "on")), class: "icon-button calendar-panel-toggle", aria: { pressed: @panel },
            title: (@panel ? "Hide the day panel (])" : "Show the day panel (])"), data: { keys: "]" } do %>
        <%= icon_tag "column-right" %><span class="visually-hidden"><%= @panel ? "Hide" : "Show" %> the day panel</span>
      <% end %>
      <%= link_to calendar_time_offs_path, class: "btn btn--ghost btn--sm" do %>
        <%= icon_tag "person" %> <span>Time off</span>
      <% end %>
      <%= link_to calendar_feed_path, class: "btn btn--ghost btn--sm", title: "Add this calendar to Google Calendar, Outlook or Apple’s" do %>
        <%= icon_tag "share" %> <span>Subscribe</span>
      <% end %>
    </div>
  </div>

  <div class="<%= class_names("calendar-layout", "calendar-layout--wide": !@panel) %>">
    <section class="calendar-main" aria-label="<%= @period.title %>">
      <% if @period.view == "agenda" %>
        <%= render "calendar/calendars/agenda", period: @period, schedule: @schedule, day: @day, panel: @panel %>
      <% else %>
        <%= render "calendar/calendars/grid", period: @period, schedule: @schedule, day: @day, panel: @panel %>
      <% end %>
    </section>
    <% if @panel %>
      <aside class="calendar-aside">
        <turbo-frame id="calendar_day">
          <%= render "calendar/days/day", schedule: @schedule, date: @day %>
        </turbo-frame>
      </aside>
    <% end %>
  </div>
</div>
