<%# The calendar (Calendar::CalendarsController): filters and search over a month, week or agenda,
    the day picked open beside it. Each filter is runeui's filter pill (a GET form of its own that
    swaps one param and keeps the rest, with a search box in a long list), and the search a form of
    its own sent as you type, so a filtered calendar is a link; the search box is permanent across
    visits (data-turbo-permanent), so typing keeps focus while the page refreshes under it.
    Weekends, the day panel and the tasks drawer (open tasks to drag onto a day, with filters of
    their own, tasks_* params) are switched in the bar and remembered. Picking a day loads only its
    panel (the calendar_day frame), or, with the panel closed, opens it. %>
<% content_for :index_filters do %>
  <%= ui :filter, param: :person, label: "Person", value: params[:person].presence || "anyone", any: false, search: true, options: calendar_person_options %>
  <%= ui :filter, param: :client, label: term(:client), value: params[:client].presence || "all", any: false, search: true, options: calendar_client_options %>
  <%= ui :filter, param: :work, label: term(:work), value: params[:work].presence || "all", any: false, search: true, options: calendar_work_options %>
  <%= ui :filter, param: :show, label: "Show", value: @schedule.show, any: false, options: calendar_show_options %>
  <%= form_with url: calendar_page_path, method: :get, class: "calendar-search", data: { controller: "form", turbo_action: "replace" } do %>
    <% calendar_carried_params(except: "q").each do |name, value| %>
      <%# herb:key name %>
      <input type="hidden" name="<%= name %>" value="<%= value %>">
    <% end %>
    <%= icon_tag "search", class: "calendar-search__icon" %>
    <%= ui :input, type: :search, name: "q", id: "calendar_search", value: params[:q], size: :sm, class: "calendar-search__input",
          placeholder: "Search people, #{term(:work).downcase}, #{term(:task, count: 2).downcase}…", autocomplete: "off", aria: { label: "Search the calendar" },
          data: { turbo_permanent: true, "1p-ignore": "true", action: "input->form#debouncedSubmit" } %>
  <% end %>
  <% if @schedule.filtered? %>
    <%= ui :button, href: calendar_page_path(params.permit(:view, :date).to_h), variant: :ghost, size: :sm, content: "Clear" %>
  <% end %>
<% end %>
<%# Tasks ticked in the drawer: the core's bulk bar takes the toolbar's row, to give them a date or
    someone to do them (bulk_tasks_path runs each task's own update). %>
<% if @preferences.drawer? %>
  <% content_for :index_bulk do %>
    <%= bulk_bar do %>
      <%= bulk_date bulk_tasks_path, method: :patch, name: "task[due_on]", label: "Due" %>
      <%= bulk_menu bulk_tasks_path, method: :patch, name: "task[owner_id]", label: "Who’s on it", choices: [ [ "Nobody yet", "none" ] ] + User.people.active.ordered.map { [ it.display_name, it.id ] } %>
    <% end %>
  <% end %>
<% end %>
<%= render "layouts/shared/index_toolbar", new_text: "Add time off", new_path: new_calendar_time_off_path(date: @day.iso8601) %>

<div class="<%= class_names("calendar", "calendar--drawer-open": @preferences.drawer?) %>" data-controller="drag-and-drop"
  data-drag-and-drop-dragged-item-class="drag-and-drop__dragged-item" data-drag-and-drop-hover-container-class="drag-and-drop__hover-container"
  data-action="dragstart->drag-and-drop#dragStart dragover->drag-and-drop#dragOver drop->drag-and-drop#drop dragend->drag-and-drop#dragEnd">
  <div class="calendar-bar">
    <div class="calendar-bar__nav">
      <%= ui :button, href: calendar_link(date: @period.previous.iso8601, day: nil), variant: :ghost, size: :icon_sm, title: "Previous (h)",
            aria: { label: "Previous" }, data: { keys: "h" }, content: icon_tag("arrow-left") %>
      <%= ui :button, href: calendar_link(date: nil, day: nil), variant: :outline, size: :sm, title: "Today (t)", data: { keys: "t" }, content: "Today" %>
      <%= ui :button, href: calendar_link(date: @period.following.iso8601, day: nil), variant: :ghost, size: :icon_sm, title: "Next (l)",
            aria: { label: "Next" }, data: { keys: "l" }, content: icon_tag("arrow-right") %>
      <h2 class="calendar-bar__title"><%= @period.title %></h2>
    </div>
    <div class="calendar-bar__actions">
      <%= ui :toggle_group, value: @period.view, variant: :outline, size: :sm, label: "View", options: calendar_view_options %>
      <%= ui :button, href: calendar_link(weekends: @preferences.flipped(:weekends)), variant: :outline, size: :sm, class: "calendar-toggle",
            aria: { pressed: @preferences.weekends?.to_s }, title: (@preferences.weekends? ? "Hide Saturdays and Sundays" : "Show Saturdays and Sundays"),
            content: safe_join([ tag.span(icon_tag("check"), class: "calendar-toggle__box", aria: { hidden: true }), tag.span("Weekends") ]) %>
      <%= ui :button, href: calendar_link(drawer: @preferences.flipped(:drawer)), variant: :outline, size: :sm, class: "calendar-toggle",
            aria: { pressed: @preferences.drawer?.to_s }, title: (@preferences.drawer? ? "Hide the tasks drawer (r)" : "Tasks to put on a day (r)"), data: { keys: "r" },
            content: safe_join([ icon_tag("board"), tag.span(term(:task, count: 2)) ]) %>
      <%= ui :button, href: calendar_link(panel: @preferences.flipped(:panel)), variant: :ghost, size: :icon_sm, class: "calendar-toggle",
            aria: { pressed: @preferences.panel?.to_s, label: "#{@preferences.panel? ? "Hide" : "Show"} the day panel" },
            title: (@preferences.panel? ? "Hide the day panel (])" : "Show the day panel (])"), data: { keys: "]" }, content: icon_tag("column-right") %>
      <%= ui :button, href: calendar_time_offs_path, variant: :ghost, size: :sm, content: safe_join([ icon_tag("person"), tag.span("Time off") ]) %>
      <%= ui :button, href: calendar_feed_path, variant: :ghost, size: :sm, title: "Add this calendar to Google Calendar, Outlook or Apple’s",
            content: safe_join([ icon_tag("share"), tag.span("Subscribe") ]) %>
    </div>
  </div>

  <div class="<%= class_names("calendar-layout", "calendar-layout--wide": !@preferences.panel?) %>">
    <section class="calendar-main" aria-label="<%= @period.title %>">
      <% if @period.view == "agenda" %>
        <%= render "calendar/calendars/agenda", period: @period, schedule: @schedule, day: @day, panel: @preferences.panel? %>
      <% elsif @period.team? %>
        <%= render "calendar/calendars/team", period: @period, schedule: @schedule, day: @day, panel: @preferences.panel? %>
      <% elsif @period.timeline? %>
        <%= render "calendar/calendars/timeline", timeline: @timeline %>
      <% else %>
        <%= render "calendar/calendars/grid", period: @period, schedule: @schedule, day: @day, panel: @preferences.panel? %>
      <% end %>
    </section>
    <% if @preferences.panel? %>
      <aside class="calendar-aside">
        <turbo-frame id="calendar_day">
          <%= render "calendar/days/day", schedule: @schedule, date: @day %>
        </turbo-frame>
      </aside>
    <% end %>
  </div>

  <% if flash[:calendar_undo].present? %>
    <%= render "calendar/calendars/undo", undo: flash[:calendar_undo] %>
  <% end %>

  <% if @preferences.drawer? %>
    <%= render "calendar/drawers/drawer", drawer: @drawer %>
  <% end %>
</div>
