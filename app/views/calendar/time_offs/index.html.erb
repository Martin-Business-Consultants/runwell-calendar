<%# Who's out from today on (Calendar::TimeOffsController#index), soonest first. %>
<%= parent_page "Calendar", calendar_page_path %>
<% content_for :index_filters do %>
  <%= ui :filter, param: :person, label: "Person", value: params[:person].presence || "anyone", any: false, search: true, options: calendar_person_options %>
<% end %>
<%= render "layouts/shared/index_toolbar", new_text: "Add time off", new_path: new_calendar_time_off_path %>

<% if @time_offs.any? %>
  <%= ui :table, id: "calendar_time_offs", class: "calendar-time-off-table" do %>
    <thead>
      <tr>
        <th data-grow>Who</th>
        <th>When</th>
        <th>Note</th>
        <th data-align="end"><span class="ui-sr-only">Actions</span></th>
      </tr>
    </thead>
    <tbody>
      <% @time_offs.each do |off| %>
        <%# herb:key off.id %>
        <tr data-filter-target="item">
          <td data-grow><span class="calendar-out"><%= person_tag off.user %> <span><%= off.user.display_name %></span></span></td>
          <td>
            <span class="calendar-time-off-table__when">
              <%= link_to calendar_page_path(date: off.starts_on.iso8601, day: off.starts_on.iso8601) do %>
                <%= off.span_text %><% if off.half_day? %> · half day<% end %>
              <% end %>
              <% if off.state == "current" %>
                <%= ui :badge, variant: :success, content: off.state_label %>
              <% end %>
            </span>
          </td>
          <td data-truncate class="calendar-time-off-table__note"><%= off.note if off.note_visible_to?(Current.user) %></td>
          <td data-align="end">
            <% if off.manageable_by?(Current.user) %>
              <span class="calendar-row-actions">
                <%= ui :button, href: edit_calendar_time_off_path(off), variant: :ghost, size: :icon_sm, title: "Change this time off",
                      aria: { label: "Change #{off.user.display_name}’s time off" }, content: icon_tag("pencil") %>
                <%= render "layouts/shared/delete_dialog", name: "#{off.user.display_name}’s time off (#{off.span_text})", path: calendar_time_off_path(off),
                      message: "They show as in again for those days." %>
              </span>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  <% end %>
<% else %>
  <%= ui :empty, description: "No one’s out from today on.", action: ui(:button, href: new_calendar_time_off_path, variant: :outline, size: :sm, content: "Add time off") %>
<% end %>
