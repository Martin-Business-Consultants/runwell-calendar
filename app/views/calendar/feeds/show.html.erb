<%# Subscribe (Calendar::FeedsController): the person's private link for their own calendar app
    (shown once, when it's made; then reset or turned off), and the other way round, their own
    calendar's private link, read so Runwell knows when they're busy (Calendar::BusyFeed). %>
<% busy = Calendar::BusyFeed.find_by(user: Current.user.person) %>
<%= parent_page "Calendar", calendar_page_path %>
<section class="record-page">
  <header class="record-page__header">
    <div class="record-page__heading">
      <h1 class="page-title">Subscribe</h1>
      <p class="record-page__description">See Runwell’s dates in Google Calendar, Outlook or Apple’s Calendar.</p>
    </div>
  </header>
  <div class="record-page__main">
    <section class="card">
      <header class="card__head">
        <h2 class="card__title">Your calendar link</h2>
        <p class="card__hint">Your open <%= term(:task, count: 2).downcase %> with a due date, everyone’s time off, and every date you can see, from a month back to six months ahead. Calendar apps check it every few hours.</p>
      </header>
      <div class="card__content stack">
        <% if @feed&.token %>
          <%= copy_field calendar_subscription_url(token: @feed.token, format: "ics", host: Runwell.host, protocol: Runwell.protocol) %>
          <p class="muted small">Copy it now: it’s shown only once. Anyone with it can read these dates, so keep it to yourself.</p>
        <% elsif @feed %>
          <p>Your link is on<%= ", last read #{time_ago_in_words(@feed.last_fetched_at)} ago" if @feed.last_fetched_at %>. It isn’t shown again; reset it for a new one (the old one stops working).</p>
        <% else %>
          <p class="muted">You don’t have a link yet.</p>
        <% end %>
        <div class="button-row">
          <%= button_to(@feed ? "Reset link" : "Make my link", calendar_feed_path, class: "btn btn--primary btn--sm") %>
          <% if @feed %>
            <%= button_to "Turn off", calendar_feed_path, method: :delete, class: "btn btn--ghost btn--sm" %>
          <% end %>
        </div>
      </div>
    </section>

    <section class="card">
      <header class="card__head">
        <h2 class="card__title">Your busy time</h2>
        <p class="card__hint">Connect your own calendar so Runwell knows when you’re busy: an all-day event counts as out (anything of yours due then is flagged), meetings show as busy. Only you see what they’re called; everyone else sees “Busy”. Read each night, from two weeks back to three months ahead.</p>
      </header>
      <div class="card__content stack">
        <% if busy %>
          <p>
            Connected<%= ", read #{time_ago_in_words(busy.synced_at)} ago" if busy.synced_at %>.
            <% if busy.error.present? %>
              <strong>It couldn’t be read last time:</strong> <%= busy.error %>.
            <% end %>
          </p>
        <% end %>
        <%= form_with url: calendar_busy_feed_path, method: :patch, scope: :busy_feed, class: "calendar-busy-form" do |form| %>
          <label class="field">
            <span class="field__label">Your calendar’s private link</span>
            <%= form.url_field :url, placeholder: "https://calendar.google.com/calendar/ical/…/private-…/basic.ics", autocomplete: "off", required: true %>
            <span class="field__hint">Google Calendar: your calendar’s Settings, “Secret address in iCal format”. Outlook: Settings, Calendar, Shared calendars, Publish a calendar, ICS link.</span>
          </label>
          <div class="button-row">
            <button type="submit" class="btn btn--primary btn--sm"><%= busy ? "Replace the link" : "Connect" %></button>
          </div>
        <% end %>
        <% if busy %>
          <%= button_to "Disconnect", calendar_busy_feed_path, method: :delete, class: "btn btn--ghost btn--sm" %>
        <% end %>
      </div>
    </section>
  </div>
  <aside class="record-page__aside">
    <section class="card card--sm">
      <header class="card__head"><h2 class="card__title">Adding it</h2></header>
      <div class="card__content">
        <p class="muted small"><strong>Google Calendar:</strong> Other calendars, +, From URL.</p>
        <p class="muted small"><strong>Outlook:</strong> Add calendar, Subscribe from web.</p>
        <p class="muted small"><strong>Apple Calendar:</strong> File, New Calendar Subscription.</p>
      </div>
    </section>
  </aside>
</section>
